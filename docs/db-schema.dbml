// Neev Database Schema
// Paste into https://dbdiagram.io

Table tenants {
  id bigint [pk, increment]
  name varchar
  slug varchar [unique]
  primary_hostname_id bigint [null, ref: > hostnames.id, note: 'canonical custom host; null when served only at the platform subdomain']
  activated_at timestamp [null]
  inactive_reason varchar [null]
  created_at timestamp
  updated_at timestamp
}

Table users {
  id bigint [pk, increment]
  tenant_id bigint [null, note: 'no FK constraint; references tenants.id, which is created after users']
  name varchar
  username varchar [null]
  email varchar [null]
  email_verified_at timestamp [null]
  password varchar [null]
  password_history json [null]
  password_changed_at timestamp [null]
  active boolean [default: true]
  default_team_id bigint [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, email) [unique]
    email
    tenant_id
    default_team_id
  }
}

Table login_attempts {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  method varchar
  multi_factor_method varchar [null]
  location json [null]
  platform varchar [null]
  browser varchar [null]
  device varchar [null]
  ip_address varchar [null]
  is_success boolean [default: false]
  is_suspicious boolean [default: false]
  created_at timestamp
  updated_at timestamp

  indexes {
    user_id
  }
}

Table otp {
  id bigint [pk, increment]
  owner_id bigint
  owner_type varchar
  purpose varchar [note: 'email_verification | confirmation | password_reset (OtpPurpose)']
  otp varchar [note: 'hashed']
  attempts tinyint [default: 0, note: 'wrong guesses; refused at OTP::MAX_ATTEMPTS']
  expires_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (owner_id, owner_type, purpose) [unique, note: 'one live code per owner per purpose']
  }

  Note: 'Emailed codes. Polymorphic owner (the user model); no foreign key, so deleting a user deletes its rows in code'
}

Table passkeys {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  credential_id varchar [unique]
  rp_id varchar [null, note: 'relying party the credential is bound to; null reads as neev.relying_party_id']
  name varchar [null]
  ip varchar [null]
  location text [null]
  last_used timestamp [null]
  public_key text
  aaguid text
  transports text [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    rp_id
  }
}

Table multi_factor_auths {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  method varchar
  status varchar [default: 'active', note: 'pending | active; pending until setup is verified']
  secret text [null, note: 'encrypted']
  otp varchar [null, note: 'hashed']
  attempts tinyint [default: 0, note: 'wrong guesses; refused at MultiFactorAuth::MAX_ATTEMPTS']
  preferred boolean [default: false]
  expires_at timestamp [null]
  last_used timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, method) [unique]
    user_id
  }
}

Table recovery_codes {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  code varchar
  created_at timestamp
  updated_at timestamp
}

Table access_tokens {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  tenant_id bigint [null, ref: > tenants.id]
  attempt_id bigint [null, note: 'no FK constraint; references login_attempts.id']
  name varchar
  token varchar [unique, note: 'bcrypt hashed (Laravel hashed cast)']
  token_type varchar [default: 'login']
  permissions json [null]
  last_used_at timestamp [null]
  expires_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    user_id
    attempt_id
    expires_at
  }
}

Table teams {
  id bigint [pk, increment]
  tenant_id bigint [null, ref: > tenants.id]
  user_id bigint [ref: > users.id, note: 'owner']
  name varchar
  slug varchar [null]
  primary_hostname_id bigint [null, ref: > hostnames.id, note: 'canonical custom host; null when served only at the platform subdomain']
  is_public boolean [default: true]
  activated_at timestamp [null]
  inactive_reason varchar [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, slug) [unique, note: 'unique per tenant in isolated mode; NULL tenant_id rows (shared mode) are checked by Team\'s save, per SQL NULL semantics']
    slug
  }
}

Table team_user {
  id bigint [pk, increment]
  team_id bigint [ref: > teams.id]
  user_id bigint [ref: > users.id]
  joined boolean [default: false]
  action enum_action [default: 'request_to_user', note: 'request_to_user | request_from_user']
  created_at timestamp
  updated_at timestamp

  indexes {
    (team_id, user_id) [unique]
    team_id
    user_id
  }

  Note: 'Pivot table for team membership. Roles are managed via acl_role_assignments.'
}

Table team_invitations {
  id bigint [pk, increment]
  team_id bigint [ref: > teams.id]
  email varchar
  role varchar [null]
  token varchar [null, note: 'hashed; the secret the invitation link carries']
  expires_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (team_id, email) [unique]
  }
}

Table domains {
  id bigint [pk, increment]
  owner_type varchar [null, note: 'team or tenant']
  owner_id bigint [null]
  enforce boolean [default: false]
  domain varchar
  verification_token varchar [null, note: 'plaintext']
  is_primary boolean [default: false]
  verified_at timestamp [null]
  verification_failed_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    domain
    (owner_type, owner_id)
    (domain, verified_at)
  }

  Note: 'Polymorphic owner: Team or Tenant. Being replaced by hostnames and email_domains (RFC 006)'
}

Table domain_rules {
  id bigint [pk, increment]
  domain_id bigint [ref: > domains.id]
  name varchar
  value varchar [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, domain_id) [unique]
  }
}

Table hostnames {
  id bigint [pk, increment]
  owner_type varchar [note: 'any model: team, tenant, or the app\'s own']
  owner_id bigint
  host varchar [unique, note: 'canonical: lowercase, no trailing dot']
  status varchar [default: 'pending', note: 'pending | verified | failed']
  verification_token varchar [null]
  verified_at timestamp [null]
  verification_failed_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (owner_type, owner_id)
  }

  Note: 'RFC 006: a custom host an owner is served at. Platform subdomains are derived from the slug and never stored'
}

Table email_domains {
  id bigint [pk, increment]
  owner_type varchar [note: 'any model: team, tenant, or the app\'s own']
  owner_id bigint
  domain varchar [note: 'canonical: lowercase, no trailing dot']
  status varchar [default: 'pending', note: 'pending | verified | failed']
  verification_strategy varchar [default: 'dns']
  verification_token varchar [null]
  verified_at timestamp [null]
  verification_failed_at timestamp [null]
  enforce boolean [default: false]
  created_at timestamp
  updated_at timestamp

  indexes {
    (owner_type, owner_id)
    (owner_type, owner_id, domain) [unique, note: 'unique per owner only: several owners may verify one domain']
    (domain, verified_at)
  }

  Note: 'RFC 006: an email domain whose users belong to the owner'
}

Table retired_slugs {
  id bigint [pk, increment]
  owner_type varchar [note: 'morph class of the model that retired it']
  owner_id bigint
  slug varchar
  created_at timestamp [note: 'when it was retired; the old host serves for neev.slug.retired_host_days after this']
  updated_at timestamp

  indexes {
    (owner_type, owner_id)
    (owner_type, slug)
  }

  Note: 'RFC 006: a slug its owner renamed away from. Never issued to another owner of the same kind; the owner may take it back, which deletes the row'
}

Table team_auth_settings {
  id bigint [pk, increment]
  team_id bigint [unique, ref: - teams.id]
  auth_method varchar [default: 'password']
  sso_provider varchar [null]
  sso_client_id varchar [null]
  sso_client_secret text [null, note: 'encrypted']
  sso_tenant_id varchar [null]
  sso_extra_config json [null]
  auto_provision boolean [default: false]
  auto_provision_role varchar [null]
  require_mfa boolean [default: false, note: 'RFC 006: the owner\'s mfa rule, once a domain_rules row']
  created_at timestamp
  updated_at timestamp
}

Table tenant_auth_settings {
  id bigint [pk, increment]
  tenant_id bigint [unique, ref: - tenants.id]
  auth_method varchar [default: 'password']
  sso_provider varchar [null]
  sso_client_id varchar [null]
  sso_client_secret text [null, note: 'encrypted']
  sso_tenant_id varchar [null]
  sso_extra_config json [null]
  auto_provision boolean [default: false]
  auto_provision_role varchar [null]
  require_mfa boolean [default: false, note: 'RFC 006: the owner\'s mfa rule, once a domain_rules row']
  created_at timestamp
  updated_at timestamp
}

Table magic_link_tokens {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  tenant_id bigint [null, ref: > tenants.id]
  token varchar [unique, note: 'SHA-256 hash of the opaque token']
  channel varchar [default: 'web', note: 'web / mobile / custom']
  meta_data json [null, note: 'Holds the browser/device binding fingerprint']
  user_agent text [null]
  created_ip varchar [null]
  expires_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, channel)
    expires_at
  }
}

// Cross-table refs that can't be inline
Ref: users.default_team_id > teams.id
